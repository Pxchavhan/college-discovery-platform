generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id            Int             @id @default(autoincrement())
  name          String
  location      String
  description   String?
  established   Int?
  fees          Int?
  placements    String?
  placementPct  Float?
  rating        Float?
  courses       String[]
  savedColleges SavedCollege[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String
  savedColleges  SavedCollege[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SavedCollege {
  id         Int      @id @default(autoincrement())
  userId     Int
  collegeId  Int

  user       User     @relation(fields: [userId], references: [id])
  college    College  @relation(fields: [collegeId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([userId, collegeId])
}